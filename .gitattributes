# Gradle wrapper files are verified against gradle/wrapper/gradle-wrapper.sha256. The checksums cover the
# committed bytes, so no checkout-time conversion may apply. gradlew.bat is committed with CRLF line endings
# (as generated by Gradle) and is excluded from text normalization; the other files are committed with LF.
gradlew text eol=lf
gradlew.bat -text
gradle/wrapper/gradle-wrapper.properties text eol=lf
gradle/wrapper/*.sha256 text eol=lf
gradle/wrapper/gradle-wrapper.jar binary
