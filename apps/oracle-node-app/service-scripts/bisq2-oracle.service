[Unit]
Description=Bisq Oracle
After=network.target

[Service]
SyslogIdentifier=bisq2-oracle
EnvironmentFile=/etc/default/bisq2-oracle.env
ExecStart=/bisq2/bisq2/apps/oracle-node-app/build/install/oracle-node-app/bin/oracle-node-app
ExecStop=/bin/kill -TERM ${MAINPID}
Restart=on-failure
# Exit code 3: a migration of the data directory failed. A restart would only fail again.
RestartPreventExitStatus=3

User=bisq2
Group=bisq2

PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
PrivateDevices=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
